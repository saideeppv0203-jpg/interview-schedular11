# Copy this file to .env and fill in your own values before deploying.

# Recommended for production: managed PostgreSQL connection string.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vxuwxoumjhjxorybfill.supabase.co:5432/postgres
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password
# A long random string used to authorize admin approve/reject requests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-random-admin-token

PORT=4000

# Optional local fallback if DATABASE_URL is not set.
# DB_PATH=/var/data/data.sqlite

# Only needed in production if you choose the SQLite fallback or a mounted disk.
# Leave unset for local development.
# DATA_DIR=/var/data
